# Production server environment (docs/DEPLOYMENT.md). Copy to the server, fill in, and load it into
# the process environment (systemd EnvironmentFile=, docker --env-file, ...). Never commit the filled
# file: `.env` and `.env.*.local` are gitignored; keep the real one outside the repository.

# Listen address and port. Keep 127.0.0.1 behind a reverse proxy that terminates HTTPS.
HOST=127.0.0.1
PORT=8080

# The public origin(s) the browser loads the study from, comma-separated (scheme://host[:port]).
# Same-origin requests are always allowed; list the origin here if the proxy rewrites the Host header.
ALLOWED_ORIGINS=https://study.example.org

# Finished session files: <SESSION_LOG_DIR>/<sessionId>.jsonl. On an encrypted, backed-up volume.
SESSION_LOG_DIR=/var/lib/fire-sim/sessions

# The built app (npm run build:prod writes dist/ui).
STATIC_DIR=dist/ui

# Thinker: on (hybrid retrieval, the declared treatment), lexical (development only) or off (Haku only).
THINKER=on

# study (the default): the Thinker proxy refuses to start unless the declared treatment is complete,
# including the English index content/thinker/index.en.json, built and frozen (docs/DEPLOYMENT.md
# step 3). demo: English questions fall back to the Finnish index when it is absent (never for a study).
THINKER_MODE=study

# The model key, from the environment only. Never in the repository, never sent to the browser.
GEMINI_API_KEY=
